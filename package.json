{
  "name": "@mochi/agent",
  "version": "0.31.0",
  "description": "Minimal, fast, autonomous coding agent: Rust runtime core with a TypeScript frontend.",
  "type": "module",
  "bin": {
    "mochi": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/mochi-bin",
    "native/bin",
    "scripts/browser-daemon.mjs",
    "scripts/browser-driver.mjs",
    "scripts/browser-login.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prebuild:bin": "node scripts/sync-version.mjs",
    "build:bin": "bun build src/cli.ts --compile --minify --bytecode --target=bun --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/mochi-bin",
    "prepack": "node scripts/prepack.mjs",
    "build:rust": "node scripts/build-native.mjs",
    "build:native": "node scripts/build-native.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=dot",
    "bench": "node bench/startup.mjs",
    "bench:efficiency": "node bench/efficiency.mjs",
    "bench:task": "node bench/task.mjs",
    "bench:stream": "tsx bench/streaming.mjs",
    "typecheck": "tsc --noEmit",
    "bench:memory": "node bench/memory.mjs",
    "gate": "tsx src/cli.ts gate run",
    "bench:speculation": "tsx bench/speculation.mjs",
    "bench:endurance": "tsx bench/endurance.ts",
    "release:check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.12"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "terminal",
    "llm"
  ],
  "license": "MIT"
}
