# GitHub Linguist overrides to reflect Rust core architecture
*.test.ts linguist-vendored=true
*.test.js linguist-vendored=true
*.bench.ts linguist-vendored=true
src/**/*.test.ts linguist-vendored=true
src/testutil/** linguist-vendored=true
bench/** linguist-vendored=true
docs/** linguist-documentation=true
package-lock.json linguist-generated=true
CHANGELOG.md linguist-documentation=true

# Mark legacy TS runtime as generated/vendored to highlight Rust rewrite
src/**/*.ts linguist-generated=true
src/**/*.js linguist-generated=true

# TUI remains strictly TypeScript
src/tui/**/*.ts linguist-generated=false

native/** linguist-detectable=true
native/mochi_core/** linguist-detectable=true
native/rust/** linguist-detectable=true
