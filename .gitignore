node_modules
dist
.mochi
dogfood
*.log
.DS_Store
native/bin
native/mochi_core/target
skills/skills.json
__pycache__
*.pyc

# Secrets & credentials protection
*.env
*.env.*
*.p12
*token*
*secret*
*.pem
*.key
*.sqlite
*.sqlite-journal
*.sqlite3
# MCP server configs may inline client secrets; track only the example.
.mcp.json
mcp-oauth.json

# Test coverage artifacts
coverage/

# Non-deterministic benchmark outputs (rewritten every arena run; flakes pollute diffs)
bench/arena-results.json

# Editor extension build artifacts (rebuilt via vsce / gradle; never commit)
editors/vscode/out/
editors/vscode/*.vsix
editors/jetbrains/build/
editors/jetbrains/.gradle/
# NOTE: gradle-wrapper.jar IS committed (required for reproducible builds).
aimbot-venv/
*.env

# Scratch dirs used by the plan-mode verify-with-rollback tests (workspace-local, gitignored)
.revtmp/

# Frozen bench tasks are hash-pinned repository content and must stay
# trackable — the *token* secrets rule above would otherwise swallow
# task dirs such as bench/frozen/tasks/hist-fix-dashboard-token-leak/.
!bench/frozen/**
