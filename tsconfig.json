{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "ES2024"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*"],
  // testutil is a vitest-only in-process fake provider: excluding it keeps the
  // fake (and its HTTP harness) out of dist/ and the published tarball.
  // Vitest transforms TS sources directly, so tests are unaffected.
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/testutil"]
}
